# Server-only connection string for the early-access signup table.
# Any standard PostgreSQL works, including a hosted pooled endpoint. Local
# development can point at a local Postgres. Never expose through NEXT_PUBLIC_*.
# Unset means POST /early-access fails closed with 503 instead of faking success.
DATABASE_URL=

# Optional fan-out to an email provider or list tool. The signup is stored
# first and the forward is scheduled after the response, so a slow or broken
# destination can never fail a signup.
EARLY_ACCESS_WEBHOOK_URL=
EARLY_ACCESS_WEBHOOK_TOKEN=

# Canonical origin, used for metadata, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://porcess.com

# Optional analytics collector. Unset means events are dropped (no third-party
# script is loaded either way).
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
