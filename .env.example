# Server-only connection string. Two tables live here: the early-access list and
# the analytics events behind /a/n/stats. Any standard PostgreSQL works,
# including a hosted pooled endpoint. Local development can point at a local
# Postgres. Never expose through NEXT_PUBLIC_*.
# Unset means POST /early-access fails closed with 503 instead of faking
# success, and events are dropped.
DATABASE_URL=

# The password for the private dashboard at /a/n/stats. Unset means the whole
# private area returns 404, which is the correct state for a deployment nobody
# has protected yet. Changing it signs out every existing session.
STATS_PASSWORD=

# How long analytics events are kept by `pnpm stats:purge`. Signups are never
# purged. Defaults to 365.
STATS_RETENTION_DAYS=365

# Optional fan-out to an email provider or list tool. The signup is stored
# first and the forward is scheduled after the response, so a slow or broken
# destination can never fail a signup.
EARLY_ACCESS_WEBHOOK_URL=
EARLY_ACCESS_WEBHOOK_TOKEN=

# Canonical origin, used for metadata, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://porcess.com

# Optional override for where events are sent. Unset is the normal case: the
# page posts to its own /analytics, so the numbers stay in our database and no
# third party sees a visitor.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
